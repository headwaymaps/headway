#!/bin/bash -e

function usage() {
  cat << EOF
Copy deployment artifacts to asset host
usage: $0 <build-dir> [ --host remote.host.com ]
examples:
    # Copy to asset root on this host
    $0 builds/planet
    # Copy to asset root on remote host
    $0 builds/planet --host data.maps.internal

Use an upload prefix other than what's in bin/_headway_version.sh
    HEADWAY_DATA_TAG=dev $0 builds/Seattle
    HEADWAY_DATA_TAG=dev $0 builds/Seattle --host data.maps.internal
EOF
}

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
  usage
  exit 1
fi
CONFIG_DIR=$1

HOST=""
if [ "$#" -eq 3 ]; then
    if [ "$2" != "--host" ]; then
        usage
        exit 1
    fi
    HOST=$3
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
DATA_ROOT="${REPO_ROOT}/data"

OUTPUT_DIR="/srv/www/data.maps.earth"

# Run a command locally, or on $HOST if one was given.
function run() {
  if [ -z "$HOST" ]; then
    "$@"
  else
    ssh "$HOST" "$@"
  fi
}

function upload() {
  local file=$1
  local output_prefix=$2

  local input_path="${DATA_ROOT}/${HEADWAY_AREA}/${file}"
  if [ ! -f "$input_path" ]; then
    echo "pinned in ${MANIFEST} but not built here: ${file}"
    exit 1
  fi

  # The asset host mirrors data/<Area>, so a manifest value is the path here,
  # under /bootstrap in compose, and in the URLs bin/k8s/generate renders.
  local resource="${output_prefix}/${file}"
  local output_path="${OUTPUT_DIR}/${resource}"

  # rsync in both cases, so re-runs skip anything already copied.
  local destination="${output_path}"
  if [ -n "$HOST" ]; then
    destination="${HOST}:${output_path}"
  fi

  echo "Syncing ${input_path} -> ${destination}"
  run mkdir -p "$(dirname "$output_path")"
  rsync -av --partial --progress "$input_path" "$destination"
}

source bin/_source-env.sh "$CONFIG_DIR"

if [ -z "$HEADWAY_DATA_TAG" ]; then
    source "${REPO_ROOT}/bin/_headway_version.sh"
fi
export HEADWAY_DATA_TAG

set -o nounset

MANIFEST="${CONFIG_DIR}/artifacts.json"
if [ ! -f "$MANIFEST" ]; then
  echo "No pinned manifest at ${MANIFEST}"
  echo "Run bin/artifacts --pin ${CONFIG_DIR}"
  exit 1
fi

for file in $("${REPO_ROOT}/bin/artifacts" files "$CONFIG_DIR"); do
  upload "$file" "${HEADWAY_DATA_TAG}/${HEADWAY_AREA_TAG}"
done

# Generic across all areas, so they sit above the area directory.
for file in $("${REPO_ROOT}/bin/artifacts" shared-files "$CONFIG_DIR"); do
  upload "$file" "${HEADWAY_DATA_TAG}"
done

echo "Publishing complete."
echo 'Next, deploy with `bin/k8s/rollout-latest` or `bin/k8s/apply-latest`'
