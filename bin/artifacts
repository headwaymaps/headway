#!/bin/bash

set -e

APP_ROOT=$(git rev-parse --show-toplevel)
cd "$APP_ROOT"

function usage() {
  cat << EOF
Pin and look up build artifacts. This runs on the build machine: --pin reads
data/<Area>, and the lookups exist for the local docker compose stack. Anything
that generates deploy config reads builds/<Area>/artifacts.json directly.

usage: $0 <otp-graph|elevation|pmtiles|valhalla|elasticsearch|placeholder|osm> <build-config-dir>
       $0 <terrain|landcover> <build-config-dir>
       $0 <files|shared-files> <build-config-dir>
       $0 --pin <build-config-dir>
       $0 --verify <build-config-dir>

examples: # pin the newest artifacts to builds/<Area>/artifacts.json
    \$0 --pin builds/Amsterdam
    # check every pinned artifact is present in data/<Area>
    \$0 --verify builds/Amsterdam
    # what the local compose stack mounts
    \$0 otp-graph builds/planet
EOF
}

COMMAND="${1:-}"
CONFIG_DIR="${2:-}"
if [ -z "$COMMAND" ] || [ -z "$CONFIG_DIR" ]; then
    usage
    exit 1
fi

if [ ! -d "$CONFIG_DIR" ]; then
    echo "Error: config dir \"$CONFIG_DIR\" doesn't exist" >&2
    exit 1
fi

source bin/_source-env.sh "$CONFIG_DIR"

set -o nounset

MANIFEST="${CONFIG_DIR}/artifacts.json"

if ! command -v jq > /dev/null; then
    echo "Error: jq is required to read ${MANIFEST}" >&2
    exit 1
fi

case "$COMMAND" in
    --pin)
        # Generate artifacts.json from what's in data/<Area>, pinning the newest of each dated artifact.
        AREA_DIR="data/${HEADWAY_AREA}"
        TRANSIT_DIR="${AREA_DIR}/transit"
        MANIFEST="${CONFIG_DIR}/artifacts.json"

        if [ ! -d "$AREA_DIR" ]; then
            echo "Error: nothing built at ${AREA_DIR}" >&2
            exit 1
        fi

        manifest="{}"

        # Artifact names carry a blake3 content hash, so a rebuild lands next to
        # what it replaced rather than overwriting it. Which of them to pin
        # isn't ours to guess: say so and let the old one be deleted.
        function only_match() {
            local pattern="$1" matches=() path
            for path in $pattern; do
                [ -f "$path" ] && matches+=("$path")
            done

            if [ ${#matches[@]} -gt 1 ]; then
                {
                    echo "Error: ${#matches[@]} builds of ${pattern} to choose between:"
                    printf '  %s\n' "${matches[@]}"
                    echo "Delete the ones you don't want pinned, then run --pin again."
                } >&2
                exit 1
            fi
            echo "${matches[0]:-}"
        }

        function add_only_match() {
            local key="$1" pattern="$2" path
            path=$(only_match "${AREA_DIR}/${pattern}")
            [ -n "$path" ] || return 0
            manifest=$(jq --arg key "$key" --arg file "${path#"${AREA_DIR}/"}" '.[$key] = $file' <<< "$manifest")
        }

        add_only_match valhalla      "${HEADWAY_AREA}-valhalla-*.tar.zst"
        add_only_match elasticsearch "${HEADWAY_AREA}-elasticsearch-*.tar.zst"
        add_only_match placeholder   "${HEADWAY_AREA}-placeholder-*.tar.zst"
        add_only_match pmtiles       "${HEADWAY_AREA}-*.pmtiles"
        add_only_match osm           "${HEADWAY_AREA}-*.osm.pbf"

        shared="{}"
        for name in terrain landcover; do
            path=$(only_match "${AREA_DIR}/${name}-*.mbtiles")
            [ -n "$path" ] || continue
            shared=$(jq --arg key "$name" --arg file "$(basename "$path")" '.[$key] = $file' <<< "$shared")
        done
        if [ "$shared" != "{}" ]; then
            manifest=$(jq --argjson shared "$shared" '.shared = $shared' <<< "$manifest")
        fi

        # Names look like <area>-<zone>-<date>-<infix>-<hash><suffix>, e.g.
        # Seattle-puget-sound-2026-08-14-graph-2f1c9ab7.obj.zst
        #
        # Dated names sort oldest to newest, so the last write wins. Two builds
        # of the same zone on the same day can't be told apart that way, so
        # that's an error rather than a guess.
        function add_dated_by_zone() {
            local key="$1" infix="$2" suffix="$3"
            local found="{}" dates="{}" path file rest zone date prev

            for path in "${TRANSIT_DIR}/${HEADWAY_AREA}-"*"-${infix}-"*"$suffix"; do
                [ -f "$path" ] || continue
                file=$(basename "$path")

                rest=${file#"${HEADWAY_AREA}-"}
                rest=${rest%"$suffix"}
                rest=${rest%-"$infix"-*}
                if [[ ! $rest =~ ^(.+)-([0-9]{4}-[0-9]{2}-[0-9]{2})$ ]]; then
                    echo "Error: unexpected ${infix} name: ${file}" >&2
                    exit 1
                fi
                zone="${BASH_REMATCH[1]}"
                date="${BASH_REMATCH[2]}"

                if [ "$(jq -r --arg zone "$zone" '.[$zone] // empty' <<< "$dates")" = "$date" ]; then
                    prev=$(jq -r --arg zone "$zone" '.[$zone]' <<< "$found")
                    {
                        echo "Error: two ${date} builds of ${zone} to choose between:"
                        printf '  %s\n' "${prev#transit/}" "$file"
                        echo "Delete the one you don't want pinned, then run --pin again."
                    } >&2
                    exit 1
                fi

                dates=$(jq --arg zone "$zone" --arg date "$date" '.[$zone] = $date' <<< "$dates")
                found=$(jq --arg zone "$zone" --arg file "transit/$file" '.[$zone] = $file' <<< "$found")
            done

            if [ "$found" != "{}" ]; then
                manifest=$(jq --arg key "$key" --argjson found "$found" '.[$key] = $found' <<< "$manifest")
            fi
        }

        add_dated_by_zone otp-graphs graph .obj.zst
        add_dated_by_zone gtfs gtfs .tar.zst

        elevation=""
        elevation_date=""
        for path in "${TRANSIT_DIR}/${HEADWAY_AREA}-"*-elevation-tifs-*.tar.zst; do
            [ -f "$path" ] || continue
            file=$(basename "$path")

            rest=${file#"${HEADWAY_AREA}-"}
            if [[ ! $rest =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})- ]]; then
                echo "Error: unexpected elevation-tifs name: ${file}" >&2
                exit 1
            fi
            if [ "${BASH_REMATCH[1]}" = "$elevation_date" ]; then
                {
                    echo "Error: two ${elevation_date} elevation builds to choose between:"
                    printf '  %s\n' "$elevation" "$file"
                    echo "Delete the one you don't want pinned, then run --pin again."
                } >&2
                exit 1
            fi
            elevation_date="${BASH_REMATCH[1]}"
            elevation="$file"
        done
        if [ -n "$elevation" ]; then
            manifest=$(jq --arg file "transit/$elevation" '.elevation = $file' <<< "$manifest")
        fi

        jq -S . <<< "$manifest" > "$MANIFEST"

        echo "Wrote ${MANIFEST}:" >&2
        cat "$MANIFEST" >&2
        ;;
    --verify)
        # Ensure all pinned assets are present locally
        AREA_DIR="data/${HEADWAY_AREA}"

        if [ ! -f "$MANIFEST" ]; then
            echo "Error: no ${MANIFEST}; run bin/build ${CONFIG_DIR}" >&2
            exit 1
        fi

        missing=()
        while IFS= read -r file; do
            [ -n "$file" ] || continue
            [ -f "${AREA_DIR}/${file}" ] || missing+=("$file")
        done < <(jq -r '.. | strings' "$MANIFEST")

        if [ ${#missing[@]} -gt 0 ]; then
            {
                echo "Error: ${MANIFEST} pins ${#missing[@]} artifact(s) missing from ${AREA_DIR}:"
                printf '  %s\n' "${missing[@]}"
                echo
                echo "The pinned names are stale, or the build didn't finish. Either rebuild"
                echo "(bin/build ${CONFIG_DIR}), or re-pin what's already built"
                echo "(bin/artifacts --pin ${CONFIG_DIR})."
            } >&2
            exit 1
        fi

        echo "All artifacts pinned by ${MANIFEST} are present in ${AREA_DIR}."
        ;;
    otp-graph)
        [ -f "$MANIFEST" ] || exit 0
        # docker compose runs a single OTP, so serve the first zone
        jq -r 'first(."otp-graphs"[]?) // empty' "$MANIFEST"
        ;;
    elevation|pmtiles|valhalla|elasticsearch|placeholder|osm)
        [ -f "$MANIFEST" ] || exit 0
        jq -r --arg key "$COMMAND" '.[$key] // empty' "$MANIFEST"
        ;;
    terrain|landcover)
        [ -f "$MANIFEST" ] || exit 0
        jq -r --arg key "$COMMAND" '.shared[$key]? // empty' "$MANIFEST"
        ;;
    files)
        # All artifacts for the deployment except `shared`,
        # which is excluded because those publish to a different prefix.
        [ -f "$MANIFEST" ] || exit 0
        jq -r 'del(.shared) | .. | strings' "$MANIFEST"
        ;;
    shared-files)
        [ -f "$MANIFEST" ] || exit 0
        jq -r '.shared // {} | .[]' "$MANIFEST"
        ;;
    *)
        usage
        exit 1
        ;;
esac
