#!/bin/bash
# Run the Playwright browser tests against running services.
#
# Assumes the stack is already up, like bin/test/integration-tests:
#
#   bin/start-services --no-follow-logs builds/Bogota
#   bin/wait-for-services
#
# The first argument is the build whose smoke-test.env the tests assert against. The rest are
# passed through to `playwright test`, e.g.
#
#   bin/test/browser-tests builds/Bogota --headed
#   bin/test/browser-tests builds/Bogota -g "routing"

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [ $# -lt 1 ]; then
    echo "Usage: $0 <build-dir> [playwright args...]"
    exit 1
fi
CONFIG_DIR=$1
shift

cd "$APP_ROOT"
# HEADWAY_PUBLIC_URL from the environment overrides the build's, e.g. to test one blue/green host.
public_url_override=${HEADWAY_PUBLIC_URL:-}
source bin/_source-env.sh "$CONFIG_DIR"
HEADWAY_PUBLIC_URL=${public_url_override:-$HEADWAY_PUBLIC_URL}
set -a
source "$CONFIG_DIR/smoke-test.env"
set +a

if ! curl -fsS "$HEADWAY_PUBLIC_URL" >/dev/null 2>&1; then
    echo "❌ Error: nothing serving $HEADWAY_PUBLIC_URL"
    echo "   Start the stack with: bin/start-services --no-follow-logs $CONFIG_DIR"
    exit 1
fi

cd "$APP_ROOT/tests/browser"

# Playwright and its browser are dev dependencies of this directory only, so a
# fresh checkout needs them before the first run.
if [ ! -x node_modules/.bin/playwright ]; then
    echo "📦 Installing browser test dependencies..."
    yarn install
    npx playwright install chrome
fi

echo "🧪 Running browser tests against $HEADWAY_PUBLIC_URL..."
npx playwright test "$@"
