#!/bin/bash -ex

APP_ROOT=$(git rev-parse --show-toplevel)
cd "$APP_ROOT"

CONFIG_DIR="$1"
if [ -z "$CONFIG_DIR" ]; then
    cat <<EOS
$0 must specify build config directory
e.g.
    $0 builds/planet
    $0 builds/Seattle
EOS
    exit 1
fi
shift

set -o nounset

if [ ! -d "$CONFIG_DIR" ]; then
    cat <<EOS
Config dir "$CONFIG_DIR" doesn't exist
EOS
    exit 1
fi

source bin/_source-env.sh "$CONFIG_DIR"
source bin/_zone-file.sh
source bin/_build-timing.sh

trap 'bin/revert-fetch-urls; build_timing_report "$HEADWAY_AREA"; timing_cleanup' EXIT
bin/update-fetch-urls

TRANSIT_CONFIG_DIR="$CONFIG_DIR/transit"

# Each zone directory under transit/ is built into a zone named after the
# directory, and that name is used verbatim from here on: it keys artifacts.json
# and it names the OTP deployment, service and config map in k8s. So it has to
# be a valid k8s object name - cheap to check, expensive to discover after a
# multi-hour build.
function lint_zone_names() {
    set +x
    local found=0 zone file
    for file in $(zone_files_in "$CONFIG_DIR"); do
        found=1
        zone=$(zone_name_for_file "$file")
        # 63 chars is the k8s limit, minus room for the "opentripplanner-" prefix.
        if [[ ! $zone =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || [ ${#zone} -gt 40 ]; then
            echo "Error: ${file}: zone \"${zone}\" is not a valid k8s object name; rename its directory to lowercase letters, digits and dashes" >&2
            exit 1
        fi
    done

    if [ "$found" -eq 0 ]; then
        echo "Error: no */zone.json in ${TRANSIT_CONFIG_DIR} - nothing to build" >&2
        echo "Draw one with: services/gtfs/transit-zoner/start-dev-server" >&2
        exit 1
    fi
    set -x
}
lint_zone_names

# Feeds that need a credential take it from gtfs-secrets.json at the repo root,
# which is gitignored; bin/transit-credentials cuts each zone its own slice.
#
# It has to be handed to dagger as an explicit secret: module code runs
# sandboxed, so exporting it into our own environment would not reach it.
GTFS_SECRETS=""
GTFS_SECRETS_FILE="${APP_ROOT}/gtfs-secrets.json"
if [ -f "$GTFS_SECRETS_FILE" ]; then
    GTFS_SECRETS="--gtfs-secrets file://${GTFS_SECRETS_FILE}"
fi

USE_LOCAL_PBF=""
INPUT_PBF="${HEADWAY_AREA}.osm.pbf"
if [[ -f $INPUT_PBF ]]; then
    USE_LOCAL_PBF="--local-pbf ${INPUT_PBF}"
fi

timed_dagger transit -c "with-area ${HEADWAY_AREA} ${USE_LOCAL_PBF} | build-transit ${TRANSIT_CONFIG_DIR} ${GTFS_SECRETS} | export 'data/${HEADWAY_AREA}/transit'"

bin/artifacts --pin "$CONFIG_DIR"

set +x
cat <<EOS

Transit artifacts written to data/${HEADWAY_AREA}/transit and artifacts pinned.

To publish the artifacts to the asset host:
    bin/publish-data ${CONFIG_DIR} [--host remote.host.com]
EOS
