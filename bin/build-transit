#!/bin/bash -ex

APP_ROOT=$(git rev-parse --show-toplevel)
cd "$APP_ROOT"

CONFIG_DIR="$1"
if [ -z "$CONFIG_DIR" ]; then
    cat <<EOS
$0 must specify build config directory
e.g.
    $0 builds/planet
    $0 builds/Seattle
EOS
    exit 1
fi
shift

set -o nounset

if [ ! -d "$CONFIG_DIR" ]; then
    cat <<EOS
Config dir "$CONFIG_DIR" doesn't exist
EOS
    exit 1
fi

source bin/_source-env.sh "$CONFIG_DIR"

# Idempotent, and bin/build runs it too - it's here so that running this script
# standalone works on a tree where the artifact root is still the placeholder.
bin/update-fetch-urls

# Feeds whose zone entry has an `authorization` block need a credential. A zone
# can carry its own; otherwise they live in gtfs-credentials.yaml (which is
# gitignored) as a `feeds:` table keyed by Onestop ID. Generate one with:
#   dagger -c "gtfs-credentials-template | export gtfs-credentials.yaml"
#
# It has to be handed to dagger as an explicit secret: module code runs
# sandboxed, so exporting these into our own environment would not reach it.
GTFS_API_KEYS=""
if [ -f "${APP_ROOT}/gtfs-credentials.yaml" ]; then
    GTFS_API_KEYS="--gtfs-api-keys file://${APP_ROOT}/gtfs-credentials.yaml"
fi

TRANSIT_CONFIG_DIR="$CONFIG_DIR/transit"

# Each file in zones/ is built into a zone named after the file, and that name is
# used verbatim from here on: it keys artifacts.json and it names the OTP
# deployment, service and config map in k8s. So it has to be a valid k8s object
# name - cheap to check, expensive to discover after a multi-hour build.
function lint_zone_names() {
    set +x
    local found=0 zone file
    for file in "${TRANSIT_CONFIG_DIR}"/zones/*.json; do
        [ -e "$file" ] || continue
        found=1
        zone=$(basename "$file" .json)
        # 63 chars is the k8s limit, minus room for the "opentripplanner-" prefix.
        if [[ ! $zone =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || [ ${#zone} -gt 40 ]; then
            echo "Error: ${file}: zone \"${zone}\" is not a valid k8s object name; rename it to lowercase letters, digits and dashes" >&2
            exit 1
        fi
    done

    if [ "$found" -eq 0 ]; then
        echo "Error: no *.json in ${TRANSIT_CONFIG_DIR}/zones - nothing to build" >&2
        echo "Draw one with: bin/zone-builder-server" >&2
        exit 1
    fi
    set -x
}
lint_zone_names

USE_LOCAL_PBF=""
INPUT_PBF="${HEADWAY_AREA}.osm.pbf"
if [[ -f $INPUT_PBF ]]; then
    USE_LOCAL_PBF="--local-pbf ${INPUT_PBF}"
fi

dagger -c "with-area ${HEADWAY_AREA} ${USE_LOCAL_PBF} | build-transit ${TRANSIT_CONFIG_DIR} ${GTFS_API_KEYS} | export 'data/${HEADWAY_AREA}/transit'"

bin/artifacts --pin "$CONFIG_DIR"

set +x
cat <<EOS

Transit artifacts written to data/${HEADWAY_AREA}/transit and artifacts pinned.

This build rewrote the artifact URLs in place; to put them back:
    bin/revert-fetch-urls

To publish the artifacts to the asset host:
    bin/publish-data ${CONFIG_DIR} [--host remote.host.com]
EOS

