#!/bin/bash

set -e -o nounset

# Show where traced builds spent their time, from the traces bin/_trace.sh
# stores in data/traces/<name>/.
#
#     bin/build-timings                  # the latest build
#     bin/build-timings --builds 3       # the three latest
#     bin/build-timings builds/Bogota    # the latest build of that configuration
#     bin/build-timings images           # the latest bin/build-images
#     bin/build-timings <trace.jsonl.gz> # that trace
#
# Steps under 1% of their build are left out unless --all-steps.

APP_ROOT=$(git rev-parse --show-toplevel)
cd "$APP_ROOT"

source bin/_duration.sh

TRACES="data/traces"
TAB=$(printf '\t')

SHOW_ALL=""
TARGET=""
BUILDS=1
while [ $# -gt 0 ]; do
    case "$1" in
        --all-steps) SHOW_ALL=1 ;;
        --builds)
            BUILDS="${2:-}"
            if ! [[ "$BUILDS" =~ ^[1-9][0-9]*$ ]]; then
                echo "Error: --builds wants a positive count" >&2
                exit 1
            fi
            shift
            ;;
        --help | -h)
            echo "usage: $0 [--all-steps] [--builds N] [BUILD_DIR | NAME | TRACE_FILE]"
            exit 0
            ;;
        *)
            if [ -n "$TARGET" ]; then
                echo "Error: only one build may be specified" >&2
                exit 1
            fi
            TARGET="${1%/}"
            ;;
    esac
    shift
done

if ! command -v jq > /dev/null; then
    echo "Error: jq is required to read traces" >&2
    exit 1
fi

# Reduce a trace to the steps worth reporting, one per line: depth, name, and
# milliseconds. Those are the spans we mark as steps, and the top-level spans of
# each dagger command we trace. Each nests under its nearest reported ancestor.
function summarize() {
    gzip -dc "$1" | jq -n -r '
        def attr($key): any(.attributes[]?; .key == $key);
        def step: attr("headway.step");
        def ms: ((.endTimeUnixNano | tonumber) - (.startTimeUnixNano | tonumber)) / 1e6 | floor;

        [inputs.resourceSpans[].scopeSpans[].spans[]] as $all
        | ($all | map({key: .spanId, value: .}) | from_entries) as $spans
        | ($all | group_by(.parentSpanId // "") | map({key: (.[0].parentSpanId // ""), value: .}) | from_entries) as $children
        | def parent: $spans[.parentSpanId // ""];
          # dagger shows a passthrough span as its children, and hides internal ones.
          def passthrough: attr("dagger.io/ui.passthrough");
          def shown_parent: parent // {} | if passthrough then shown_parent else . end;
          # Under a traced command: dagger, then its top-level spans.
          def dagger_top_level:
              (passthrough or attr("dagger.io/ui.internal") | not)
              and (shown_parent as $cli | ($cli | step | not) and ($cli | parent // {} | attr("process.command")));
          def reported: step or dagger_top_level;
          def reported_below: ($children[.spanId] // [])[] | if reported then . else reported_below end;
          def rows($depth):
              [$depth, (.name | sub(": /.*"; "")), ms],
              ([reported_below] | sort_by(.startTimeUnixNano | tonumber)[] | rows($depth + 1));

        $all | map(select((.parentSpanId // "") == "" and step)) | first | rows(0) | @tsv'
}

function print_build() {
    local trace="$1" rows total depth name ms when
    rows=$(summarize "$trace")
    total=$(head -1 <<< "$rows" | cut -f3)
    # Anything under 1% of the build is noise at this zoom.
    local floor=0
    [ -n "$SHOW_ALL" ] || floor=$total

    # Named <UTC time>.jsonl.gz by bin/_trace.sh.
    when=$(basename "$trace" .jsonl.gz)
    printf '\n%s\n' "$when"
    while IFS="$TAB" read -r depth name ms; do
        [ $((ms * 100)) -ge "$floor" ] || continue
        printf '%*s%-*s %s (%d%%)\n' $((depth * 2)) '' $((44 - depth * 2)) "$name" \
            "$(fmt_duration "$ms")" $(((ms * 100 + total / 2) / total))
    done <<< "$rows"
}

if [ -f "$TARGET" ]; then
    print_build "$TARGET"
    echo
    exit 0
fi

# A build configuration's traces are filed under its area.
if [ -d "$TARGET" ]; then
    source bin/_source-env.sh "$TARGET"
    TARGET="$HEADWAY_AREA"
fi

# Newest first, across every name unless one was given.
traces=$(find "$TRACES/${TARGET:-}" -name '*.jsonl.gz' 2> /dev/null \
    | awk -F/ '{ print $NF "\t" $0 }' | sort -r | cut -f2 | head -n "$BUILDS")
if [ -z "$traces" ]; then
    echo "No traces${TARGET:+ for ${TARGET}} in ${TRACES} - they're written by bin/build and bin/build-images." >&2
    exit 1
fi
while IFS= read -r trace; do
    print_build "$trace"
done <<< "$traces"
echo
