#!/bin/bash

set -e -o nounset

# Show what past builds cost, from the history bin/build appends to.
#
#     bin/build-timings                    # every build, oldest first
#     bin/build-timings builds/Bogota      # just that build configuration
#     bin/build-timings --steps            # step breakdowns, newest build first
#     bin/build-timings --builds 1 --steps # just the latest build
#
# --builds N keeps the N most recent builds, in either view.
#
# By default very short steps are omitted. Show them:
#
#     bin/build-timings --all-steps
#
# bin/build ends a build with `--record`, which appends that build to the
# history and prints its breakdown:
#
#     bin/build-timings --record <timing-file> builds/Seattle
#
# The timing file is the TSV that bin/_build-timing.sh collected:
# "<label>\t<milliseconds>". A label with no "/" is a phase's wall time. Within
# a phase, "~name" is one of dagger's own top-level spans and anything else is
# a step the module reported.

APP_ROOT=$(git rev-parse --show-toplevel)
cd "$APP_ROOT"

source bin/_duration.sh

HISTORY="data/build-timings.jsonl"
BAR_WIDTH=24
TAB=$(printf '\t')

STEPS=""
SHOW_ALL=""
RECORD=""
BUILD_DIR=""
AREA=""
BUILDS=0
while [ $# -gt 0 ]; do
    case "$1" in
        --steps) STEPS=1 ;;
        --all-steps) STEPS=1 SHOW_ALL=1 ;;
        --record)
            RECORD="${2:-}"
            if [ -z "$RECORD" ]; then
                echo "Error: --record wants a timing file" >&2
                exit 1
            fi
            shift
            ;;
        --builds)
            BUILDS="${2:-}"
            if ! [[ "$BUILDS" =~ ^[1-9][0-9]*$ ]]; then
                echo "Error: --builds wants a positive count" >&2
                exit 1
            fi
            shift
            ;;
        --help | -h)
            echo "usage: $0 [--steps | --all-steps] [--builds N] [BUILD_DIR]"
            echo "       $0 --record TIMING_FILE [BUILD_DIR]"
            exit 0
            ;;
        *)
            if [ -n "$BUILD_DIR" ]; then
                echo "Error: only one build directory may be specified" >&2
                exit 1
            fi
            BUILD_DIR="${1%/}"
            ;;
    esac
    shift
done

# Timings are stored against an area's data name, but callers select the build
# configuration that produced it. Reading its .env keeps this interface aligned
# with the rest of the build scripts and avoids guessing from the directory name.
if [ -n "$BUILD_DIR" ]; then
    source bin/_source-env.sh "$BUILD_DIR"
    AREA="$HEADWAY_AREA"
fi

if ! command -v jq > /dev/null; then
    echo "Error: jq is required to read ${HISTORY}" >&2
    exit 1
fi

function children_of() {
    awk -F"$TAB" -v prefix="$2/" 'index($1, prefix) == 1 {
        rest = substr($1, length(prefix) + 1)
        if (index(rest, "/") == 0) { sub(/^~/, "", rest); print rest "\t" $2 }
    }' <<< "$1"
}

function print_steps() {
    local record="$1" steps when total
    total=$(jq -r '.total_ms' <<< "$record")
    # Anything under 1% of the build is noise at this zoom.
    local floor=0
    [ -n "$SHOW_ALL" ] || floor=$total
    # "~Headway.<func>" is the dagger span bracketing everything the module
    # did in that phase, so it is the phase over again, not a step within it.
    steps=$(jq -r '.steps_ms | to_entries
        | map(select(.key | split("/") | last | startswith("~Headway.") | not))
        | map(select(.value > 0 and .value * 100 >= $floor)) | sort_by(-.value)[]
        | "\(.key)\t\(.value)"' --argjson floor "$floor" <<< "$record")

    # Every row is shown as its share of the whole build.
    function fmt_share() {
        printf '%s (%d%%)' "$(fmt_duration "$1")" $(((($1 * 100) + (total / 2)) / total))
    }

    when=$(jq -r '.at' <<< "$record")
    when=${when%:*Z}
    printf '\n%s %s (%s total)\n' \
        "$(jq -r '.area' <<< "$record")" "${when/T/ }" "$(fmt_duration "$total")"

    while IFS="$TAB" read -r phase ms; do
        printf '  %-40s %s\n' "$phase" "$(fmt_share "$ms")"
        while IFS="$TAB" read -r step step_ms; do
            [ -n "$step" ] || continue
            printf '    %-38s %s\n' "$step" "$(fmt_share "$step_ms")"
            while IFS="$TAB" read -r child child_ms; do
                [ -n "$child" ] || continue
                printf '      %-36s %s\n' "$child" "$(fmt_share "$child_ms")"
            done <<< "$(children_of "$steps" "${phase}/${step}")"
        done <<< "$(children_of "$steps" "$phase")"
    done <<< "$(grep -v "/" <<< "$steps")"
}

# Append a finished build to the history, then print it like any other.
if [ -n "$RECORD" ]; then
    if [ ! -s "$RECORD" ]; then
        echo "No build timings were recorded." >&2
        exit 0
    fi

    # Phases run in sequence, so their wall times add up to the build's.
    total=$(grep -v "/" "$RECORD" | awk -F"$TAB" '{ total += $2 } END { printf "%d", total }')
    if [ "$total" -eq 0 ]; then
        echo "No build timings were recorded." >&2
        exit 0
    fi
    steps_json=$(jq -R -s -c 'split("\n") | map(select(length > 0) | split("\t")) | map({(.[0]): (.[1] | tonumber)}) | add' "$RECORD")
    record=$(jq -c -n --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg area "${AREA:-unknown}" \
        --argjson total "$total" --argjson steps "$steps_json" \
        '{at: $at, area: $area, total_ms: $total, steps_ms: $steps}')

    mkdir -p "$(dirname "$HISTORY")"
    printf '%s\n' "$record" >> "$HISTORY"
    print_steps "$record"
    printf '\n  (appended to %s)\n' "$HISTORY"
    exit 0
fi

if [ ! -s "$HISTORY" ]; then
    echo "No build history yet - ${HISTORY} is written by bin/build." >&2
    exit 1
fi

# The builds both views work from: newest first, one JSON record per line.
function selected_builds() {
    jq -c -n --arg area "$AREA" --argjson builds "$BUILDS" \
        '[inputs | select($area == "" or .area == $area)] | reverse
         | if $builds > 0 then .[:$builds] else . end | .[]' "$HISTORY"
}

function records() {
    selected_builds | jq -r -s 'reverse[] | [.at, .area, .total_ms] | @tsv'
}

if [ -z "$(records)" ]; then
    echo "No builds recorded${AREA:+ for ${AREA}} in ${HISTORY}." >&2
    exit 1
fi

if [ -n "$STEPS" ]; then
    while IFS= read -r record; do
        print_steps "$record"
    done < <(selected_builds)
    echo
    exit 0
fi

# Bars and percentages compare a build to the same area's previous build, so
# each area is listed and scaled on its own.
printf '\n%-10s %-17s %8s %8s\n' "AREA" "WHEN" "TOTAL" "CHANGE"
for area in $(records | cut -f2 | sort -u); do
    rows=$(records | awk -F"$TAB" -v area="$area" '$2 == area')
    longest=$(awk -F"$TAB" '{ if ($3 > max) max = $3 } END { printf "%d", max }' <<< "$rows")

    previous=""
    while IFS="$TAB" read -r at _ ms; do
        change=""
        if [ -n "$previous" ]; then
            change=$(printf '%+d%%' $(((ms - previous) * 100 / previous)))
        fi
        previous=$ms

        bar=$(printf '%*s' $((ms * BAR_WIDTH / longest)) "" | tr ' ' '#')
        when=${at%:*Z}
        printf '%-10s %-17s %8s %8s  %s\n' \
            "$area" "${when/T/ }" "$(fmt_duration "$ms")" "$change" "$bar"
    done <<< "$rows"
done
echo
