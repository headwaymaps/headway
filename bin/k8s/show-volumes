#!/bin/bash

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/_pvc-lib.sh"

function usage() {
cat << EOF
usage: $0 <namespace>

Lists headway PersistentVolumeClaims, marking each as [in-use] or [orphaned]
depending on whether anything in the cluster still references it.

Delete the orphaned ones with bin/k8s/unused-volumes <namespace> --delete

Examples:
    $0 planet
    $0 seattle
EOF
}

NAMESPACE=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        *)
            if [ -z "$NAMESPACE" ]; then
                NAMESPACE="$1"
            else
                echo "Unknown argument: $1" >&2
                usage >&2
                exit 1
            fi
            ;;
    esac
    shift
done

if [ -z "$NAMESPACE" ]; then
    usage >&2
    exit 1
fi

pvc_lib_set_namespace "$NAMESPACE"

pvc_lib_require_deps

in_use=$(in_use_claims)

found=0
while IFS=$'\t' read -r name capacity phase created; do
    [ -n "$name" ] || continue
    found=1
    if grep -qxF "$name" <<< "$in_use"; then
        status="[in-use]  "
    else
        status="[orphaned]"
    fi
    printf '  %s %-12s %-10s %-24s %s\n' "$status" "$capacity" "$phase" "$created" "$name"
done < <(headway_pvcs)

if [ "$found" -eq 0 ]; then
    echo "No headway PVCs found (nothing labeled ${HEADWAY_PVC_SELECTOR})."
fi
