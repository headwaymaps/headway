#!/bin/bash

set -e

APP_ROOT=$(git rev-parse --show-toplevel)
cd $APP_ROOT

function usage() {
cat << EOF
usage: $0 <config-dir> <output-dir>
examples:

Use containers and map-data version tags as specified in bin/_headway_version.sh
    $0 builds/planet planet

Use containers from a tag other than what's in bin/_headway_version.sh
    HEADWAY_DATA_TAG=dev $0 builds/planet planet-dev

Use containers and map-data version tags other than whats specified in bin/_headway_version.sh
    HEADWAY_DATA_TAG=dev HEADWAY_CONTAINER_TAG=dev $0 builds/Seattle seattle-dev
EOF
}

if [ ! $# -eq 2 ]; then
    usage
    exit 1
fi
CONFIG_DIR="$1"
OUTPUT_DIR="$2"

function log() {
    echo $@ 1>&2
}

if [ -z "$HEADWAY_DATA_TAG" ]; then
    source "bin/_headway_version.sh"
fi
export HEADWAY_DATA_TAG

export HEADWAY_CONTAINER_TAG="${HEADWAY_CONTAINER_TAG:-latest}"

source bin/_source-env.sh "$CONFIG_DIR"
source bin/_zone-file.sh

# Used to read the artifact manifest, and to tell a zone with realtime from one
# without.
if ! command -v jq > /dev/null; then
    echo "jq is required to generate the k8s configs" >&2
    exit 1
fi
export HEADWAY_DATA_TAG_SAFE=$(echo "$HEADWAY_DATA_TAG" | tr '._' '-' | tr '[:upper:]' '[:lower:]')
export HEADWAY_AREA_TAG_SAFE=$(echo "$HEADWAY_AREA_TAG" | tr '._' '-' | tr '[:upper:]' '[:lower:]')
set -a
source ".bin-env"
set +a

MANIFEST="${CONFIG_DIR}/artifacts.json"
if [ ! -f "$MANIFEST" ]; then
    log "missing ${MANIFEST}"
    log 'run `bin/artifacts --pin` on the build machine'
    exit 1
fi

# The pelias config is built on the build machine, but generate also runs on
# machines that don't have data/ - so the last one seen is kept alongside the
# pinned artifact manifest and used as the fallback. It lives here rather than
# in OUTPUT_DIR because `kubectl apply -f <dir>` would try to apply a stray
# .json as a manifest.
PINNED_PELIAS_CONFIG="${CONFIG_DIR}/pelias.json"
PELIAS_CONFIG_FILE="data/${HEADWAY_AREA}/${HEADWAY_AREA}.pelias.json"
if [ -f "$PELIAS_CONFIG_FILE" ]; then
    PELIAS_CONFIG_JSON=$(cat "$PELIAS_CONFIG_FILE")
    printf '%s\n' "$PELIAS_CONFIG_JSON" > "$PINNED_PELIAS_CONFIG"
elif [ -f "$PINNED_PELIAS_CONFIG" ]; then
    log "Warning: ${PELIAS_CONFIG_FILE} not found; falling back to ${PINNED_PELIAS_CONFIG}"
    PELIAS_CONFIG_JSON=$(cat "$PINNED_PELIAS_CONFIG")
else
    log "Missing pelias config file: ${PELIAS_CONFIG_FILE} and no ${PINNED_PELIAS_CONFIG} to fall back on"
    exit 1
fi

# A JSON blob inlined as an env value is a block scalar opened by `value: |`,
# so its body sits 16 spaces in - two levels deeper than the ConfigMap key it
# replaced.
indent() {
    local pad
    pad=$(printf '%*s' "$1" '')
    while IFS= read -r line; do printf '%s%s\n' "$pad" "$line"; done
}
export PELIAS_CONFIG_JSON_ENV="|
$(indent 16 <<< "$PELIAS_CONFIG_JSON")"

# Render to a staging dir and swap once everything succeeds
STAGING_DIR=$(mktemp -d)
trap 'rm -rf "$STAGING_DIR"' EXIT

# The version of the data a volume holds, as `<date>-<hash>`, derived from the
# names of the artifacts unpacked into it: the newest date, and a hash over the
# exact set (the tileserver's volume holds three). A claim named with it changes
# whenever its contents do - otherwise the init containers, which short-circuit
# on a volume that already has data, would serve the old build forever.
function volume_version() {
    local names date hash
    names=$(printf '%s\n' "$@" | sed 's#.*/##' | sort)

    date=$(grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' <<< "$names" | sort | tail -1)
    if [ -z "$date" ]; then
        log "no version in artifact name(s): $*"
        log 'these should look like <stem>-<date>-<hash>.<ext> - re-run `bin/artifacts --pin`'
        exit 1
    fi

    hash=$(shasum <<< "$names" | cut -c1-8)
    echo "${date}-${hash}"
}

function render_template() {
    local template_file=$1
    local output="${2:-$(basename $template_file | sed 's/\.tpl$//')}"

    envsubst < "$template_file" > "${STAGING_DIR}/${output}"
}

set -o nounset

function artifact_url() {
    local prefix="$1" query="$2" path
    path=$(jq -r "$query // empty" "$MANIFEST")
    if [ -z "$path" ]; then
        log "missing $query in ${MANIFEST}"
        log 'run `bin/artifacts --pin` on the build machine'
        exit 1
    fi
    echo "${HEADWAY_K8S_TEMPLATE_ARTIFACT_ROOT}/${prefix}/${path}"
}

AREA_PREFIX="${HEADWAY_DATA_TAG}/${HEADWAY_AREA_TAG}"

# terrain and landcover are generic across areas, so they sit above the area directory
# Assigned on their own line so `set -e` sees the substitution's exit status:
# in `export VAR=$(...)` the status is export's, always 0.
export TERRAIN_ARTIFACT_URL LANDCOVER_ARTIFACT_URL AREAMAP_ARTIFACT_URL
export VALHALLA_ARTIFACT_URL PLACEHOLDER_ARTIFACT_URL ELASTICSEARCH_ARTIFACT_URL
TERRAIN_ARTIFACT_URL=$(artifact_url "${HEADWAY_DATA_TAG}" '.shared.terrain')
LANDCOVER_ARTIFACT_URL=$(artifact_url "${HEADWAY_DATA_TAG}" '.shared.landcover')
AREAMAP_ARTIFACT_URL=$(artifact_url "$AREA_PREFIX" '.pmtiles')
VALHALLA_ARTIFACT_URL=$(artifact_url "$AREA_PREFIX" '.valhalla')
PLACEHOLDER_ARTIFACT_URL=$(artifact_url "$AREA_PREFIX" '.placeholder')
ELASTICSEARCH_ARTIFACT_URL=$(artifact_url "$AREA_PREFIX" '.elasticsearch')

# Superseded volumes stay until bin/k8s/unused-volumes collects them, which is
# what makes a rollback instant.
export TILESERVER_VOLUME_VERSION VALHALLA_VOLUME_VERSION
export PLACEHOLDER_VOLUME_VERSION ELASTICSEARCH_VOLUME_VERSION
TILESERVER_VOLUME_VERSION=$(volume_version "$AREAMAP_ARTIFACT_URL" "$TERRAIN_ARTIFACT_URL" "$LANDCOVER_ARTIFACT_URL")
VALHALLA_VOLUME_VERSION=$(volume_version "$VALHALLA_ARTIFACT_URL")
PLACEHOLDER_VOLUME_VERSION=$(volume_version "$PLACEHOLDER_ARTIFACT_URL")
ELASTICSEARCH_VOLUME_VERSION=$(volume_version "$ELASTICSEARCH_ARTIFACT_URL")

export ELEVATION_ARTIFACT_URL=""
elevation_path=$(jq -r '.elevation // empty' "$MANIFEST")
if [ -n "$elevation_path" ]; then
    ELEVATION_ARTIFACT_URL="${HEADWAY_K8S_TEMPLATE_ARTIFACT_ROOT}/${AREA_PREFIX}/${elevation_path}"
fi

function generate_transit() {
  local otp_endpoints=""
  local separator=", "
  local transit_zone graph_path otp_endpoint_name

  while IFS=$'\t' read -r transit_zone graph_path; do
      otp_endpoint_name=$(generate_otp "$transit_zone" "$graph_path")
      otp_endpoints+="${separator}\"http://${otp_endpoint_name}:8000\""
  done < <(jq -r '."otp-graphs" // {} | to_entries[] | [.key, .value] | @tsv' "$MANIFEST")

  export OTP_ENDPOINTS_JSON="[\"http://valhalla:8002\"${otp_endpoints}]"
  render_template "k8s/_template/travelmux-deployment.yaml.tpl"
}

function generate_otp() {
    export TRANSIT_ZONE=$1
    local graph_path=$2

    export OTP_GRAPH_URL="${HEADWAY_K8S_TEMPLATE_ARTIFACT_ROOT}/${HEADWAY_DATA_TAG}/${HEADWAY_AREA_TAG}/${graph_path}"
    export OTP_ENDPOINT_NAME="opentripplanner-${TRANSIT_ZONE}"

    export OTP_VOLUME_VERSION
    OTP_VOLUME_VERSION=$(volume_version "$graph_path")

    # The updaters come out of the zone file the picker wrote: the artifact and
    # the realtime config that serves it are two halves of one document, so
    # there's nothing separate to keep in step with it.
    #
    # A zone with no realtime at all takes the empty branch below rather than
    # rendering an empty `updaters` array, so a zone that never had realtime
    # config doesn't acquire one here. `// []` because a config with no updaters
    # serializes as `{}` rather than as an empty list.
    local zone_file router_config=""
    zone_file=$(zone_file_for "$CONFIG_DIR" "$TRANSIT_ZONE")
    if [ -n "$zone_file" ]; then
        router_config=$(zone_router_config "$zone_file")
        if [ "$(jq '(.updaters // []) | length' <<< "$router_config")" = "0" ]; then
            router_config=""
        fi
    fi

    if [ -n "$router_config" ]; then
        export OTP_ROUTER_CONFIG_JSON_ENV="|
$(indent 16 <<< "$router_config")"
    else
        export OTP_ROUTER_CONFIG_JSON_ENV='""'
    fi

    for file in k8s/_template/opentripplanner*.tpl; do
        output=$(basename "$file" | sed 's/\.tpl$//' | sed "s/ZONE/${TRANSIT_ZONE}/")
        render_template "$file" "$output"
    done
    echo "$OTP_ENDPOINT_NAME"
}

if [ "${HEADWAY_ENABLE_TRANSIT_ROUTING:-0}" = 1 ]; then
    generate_transit
fi

# NOTE: we *do* want to enable the travelmux *service*, regardless
# of if transit routing is enabled - otherwise our nginx frontend will fail
# to start up due to the inability to resolve DNS. A better solution might
# be to remove the travelmux section from nginx altogether when transit
# routing is disabled, but that's beyond the capabilities of the simple
# envsubst we're using. For now then, we copy in the service defintion.
render_template "k8s/_template/travelmux-service.yaml.tpl"

shopt -s extglob
for file in k8s/_template/!(opentripplanner*|travelmux*).tpl
do
    render_template $file
done

mkdir -p "$OUTPUT_DIR"
rm -f "${OUTPUT_DIR}"/*
cp "${STAGING_DIR}"/* "${OUTPUT_DIR}/"

