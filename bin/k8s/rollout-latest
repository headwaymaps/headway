#!/bin/bash -e
# Apply a namespace's rendered configs, then restart every deployment.
#
# The blanket restart is what picks up containers republished to the same
# `:latest` tag, which leaves the manifest unchanged and so is invisible to
# kubectl apply. It costs a restart of every pod, including ones nothing
# changed about. If you only changed data or config, bin/k8s/apply-latest
# restarts just the pods that need it.

source "$(dirname "${BASH_SOURCE[0]}")/_deploy-lib.sh"

deploy_lib_parse_args "$@"
deploy_lib_require_clean_tree
echo "ready to roll"

deploy_lib_apply

kubectl rollout restart deployment -n "$NAMESPACE"
watch kubectl get pods -n "$NAMESPACE"
