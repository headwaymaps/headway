#!/usr/bin/env bash
set -euo pipefail

# Keep the OpenFreeMap Expressive example executable. It is intentionally a
# submodule: the style and its licence remain owned and maintained upstream.
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
EXAMPLE_DIR="$REPO_ROOT/services/tileserver/expressive"
HEADWAY_DIR="$REPO_ROOT/services/tileserver/mlss/expressive"

cd "$EXAMPLE_DIR"
npm ci
mkdir -p dist
npm run build

node --input-type=module <<'EOF'
import { readFileSync } from "node:fs";

const style = JSON.parse(readFileSync("dist/style.light.json", "utf8"));
if (style.version !== 8 || Object.keys(style.sources).length !== 1 || style.layers.length !== 119) {
  throw new Error("Expressive did not compile the pinned OpenFreeMap Bright style");
}
EOF

./node_modules/.bin/expc -i "$HEADWAY_DIR/headway-v3.exp" -o "$HEADWAY_DIR/headway-v3.json"

HEADWAY_DIR="$HEADWAY_DIR" REPO_ROOT="$REPO_ROOT" node --input-type=module <<'EOF'
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";

const compiled = JSON.parse(readFileSync(`${process.env.HEADWAY_DIR}/headway-v3.json`, "utf8"));
const reference = JSON.parse(readFileSync(`${process.env.REPO_ROOT}/services/tileserver/assets/styles/basic-v3.json`, "utf8"));
assert.deepEqual(compiled, reference, "Expressive output must match Headway v3 exactly");
EOF
