#!/bin/bash
# Stop docker compose services

set -e

CONFIG_DIR="$1"
if [ -z "$CONFIG_DIR" ]; then
    cat <<EOS
Usage: $0 <build-config-dir>

Example:
    $0 builds/Bogota
Override the compose file:
    COMPOSE_FILE=docker-compose.yaml $0 builds/Seattle
Otherwise the compose file follows the build's HEADWAY_ENABLE_TRANSIT_ROUTING setting.
EOS
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT=$(git rev-parse --show-toplevel)

cd "$APP_ROOT"

source bin/_source-env.sh "$CONFIG_DIR"
source bin/_compose-file.sh

# Stop services - cd to build dir so docker compose uses the correct .env
cd "$CONFIG_DIR"
echo "Stopping services from $CONFIG_DIR..."
docker compose -f "../../$COMPOSE_FILE" down --volumes
echo "Services stopped and volumes removed."
