#!/bin/bash

set -e

APP_ROOT=$(git rev-parse --show-toplevel)
cd "$APP_ROOT"

function usage() {
cat << EOF
usage: $0 <config-dir>

Deletes headway PersistentVolumeClaims that are stale relative to the given
config's current data/area tags. Interactively confirms the tags and the list
of PVCs to be deleted before proceeding.

example:
    $0 builds/Seattle
EOF
}

if [ ! $# -eq 1 ]; then
    usage
    exit 1
fi

CONFIG_DIR="$1"

if [ -z "$HEADWAY_DATA_TAG" ]; then
    source "bin/_headway_version.sh"
fi

source bin/_source-env.sh "$CONFIG_DIR"

DATA_SAFE=$(echo "$HEADWAY_DATA_TAG" | tr '._' '-' | tr '[:upper:]' '[:lower:]')
AREA_SAFE=$(echo "$HEADWAY_AREA_TAG" | tr '._' '-' | tr '[:upper:]' '[:lower:]')
CURRENT_SUFFIX="${AREA_SAFE}-${DATA_SAFE}"

echo "Config:      ${CONFIG_DIR}"
echo "DATA_TAG:    ${HEADWAY_DATA_TAG}"
echo "AREA_TAG:    ${HEADWAY_AREA_TAG}"
echo "Keep PVCs ending in: -${CURRENT_SUFFIX}"
echo ""

HEADWAY_PVC_PATTERN='^(valhalla|tileserver|elasticsearch|placeholder|opentripplanner)-'

pvcs=$(kubectl get pvc --no-headers -o custom-columns='NAME:.metadata.name' \
    2>/dev/null) || true

stale_pvcs=()
while IFS= read -r name; do
    name=$(echo "$name" | xargs)
    if echo "$name" | grep -qE "$HEADWAY_PVC_PATTERN"; then
        if [[ "$name" != *"-${CURRENT_SUFFIX}" ]]; then
            stale_pvcs+=("$name")
        fi
    fi
done <<< "$pvcs"

if [ "${#stale_pvcs[@]}" -eq 0 ]; then
    echo "No stale headway PVCs found."
    exit 0
fi

echo "Stale PVCs to delete:"
for pvc in "${stale_pvcs[@]}"; do
    echo "  - $pvc"
done
echo ""
read -r -p "Delete these ${#stale_pvcs[@]} PVC(s)? [y/N] " confirm
echo ""

if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "Aborted."
    exit 0
fi

for pvc in "${stale_pvcs[@]}"; do
    echo "Deleting $pvc..."
    kubectl delete pvc "$pvc"
done

echo ""
echo "Done."
