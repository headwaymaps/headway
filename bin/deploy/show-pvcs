#!/bin/bash

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/_pvc-lib.sh"

function usage() {
cat << EOF
usage: $0 [-n NAMESPACE]

Lists headway PersistentVolumeClaims, marking each as [in-use] or [orphaned]
depending on whether anything in the cluster still references it.

Delete the orphaned ones with bin/deploy/gc-pvcs --apply
EOF
}

shift_by=$(pvc_lib_parse_namespace "$@")
shift "$shift_by"

if [ $# -gt 0 ]; then
    usage
    exit 1
fi

pvc_lib_require_deps

in_use=$(in_use_claims)

found=0
while IFS=$'\t' read -r name capacity phase created area_tag data_tag; do
    [ -n "$name" ] || continue
    found=1
    if grep -qxF "$name" <<< "$in_use"; then
        status="[in-use]  "
    else
        status="[orphaned]"
    fi
    printf '  %s %-12s %-8s %s\n' "$status" "$capacity" "$phase" "$name"
    printf '             area=%s data=%s created=%s\n' "$area_tag" "$data_tag" "$created"
done < <(headway_pvcs)

if [ "$found" -eq 0 ]; then
    echo "No headway PVCs found (nothing labeled ${HEADWAY_PVC_SELECTOR})."
fi
