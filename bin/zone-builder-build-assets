#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
asset_dir="$repo_root/data/zone-builder"
atlas_dir="$asset_dir/atlas"
index_path="$asset_dir/feed-extents.gpkg"

mkdir -p "$asset_dir"

args=(
    --all
    --download
    --atlas-path "$atlas_dir"
    --out "$index_path"
)
if [[ -f "$repo_root/gtfs-credentials.yaml" ]]; then
    args+=(--config "$repo_root/gtfs-credentials.yaml")
fi

cd "$repo_root"
cargo run --release --package gtfout --bin write-gtfs-index -- "${args[@]}"
