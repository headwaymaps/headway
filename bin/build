#!/bin/bash -e

function status() {
    echo "==> $*" >&2
}

APP_ROOT=$(git rev-parse --show-toplevel)
cd "$APP_ROOT"

CONFIG_DIR="${1:-}"
if [ -z "$CONFIG_DIR" ]; then
    cat <<EOS
$0 must specify build config directory
e.g.
    $0 builds/planet
    $0 builds/Seattle --transit-only
EOS
    exit 1
fi
shift

set -o nounset

TRANSIT_ONLY=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --transit-only) TRANSIT_ONLY=1 ;;
        *)
            echo "Error: unknown option $1" >&2
            exit 1
            ;;
    esac
    shift
done

if [ ! -d "$CONFIG_DIR" ]; then
    cat <<EOS
Config dir "$CONFIG_DIR" doesn't exist
EOS
    exit 1
fi

source bin/_source-env.sh "$CONFIG_DIR"
source bin/_trace.sh

# Printed last, under the timing summary.
function next_steps() {
    cat <<EOS

Artifacts pinned in ${CONFIG_DIR}/artifacts.json. The k8s manifests still point at the
previous artifacts until you regenerate and commit them:

    bin/publish-data ${CONFIG_DIR} [--host remote.host.com]
    bin/k8s/regenerate-all
EOS
}

status "Building ${HEADWAY_AREA} from ${CONFIG_DIR}"

trace_start "$HEADWAY_AREA"
trap 'exit_code=$?; bin/revert-fetch-urls; trace_finish; [ $exit_code -ne 0 ] || next_steps' EXIT
bin/update-fetch-urls

if [ "$TRANSIT_ONLY" -eq 0 ] && [ -f "${CONFIG_DIR}/prebuild.sh" ]; then
    status "Running ${CONFIG_DIR}/prebuild.sh"
    traced prebuild "${CONFIG_DIR}/prebuild.sh"
fi

USE_LOCAL_PBF=""
INPUT_PBF="${HEADWAY_AREA}.osm.pbf"
if [ -f "$INPUT_PBF" ]; then
    USE_LOCAL_PBF="--local-pbf ${INPUT_PBF}"
fi

TRANSIT_CONFIG_DIR="$CONFIG_DIR/transit"
USE_TRANSIT_FLAGS=""
if [ -d "$TRANSIT_CONFIG_DIR" ]; then
    USE_TRANSIT_FLAGS="--transit-dir=${TRANSIT_CONFIG_DIR}"

    # Feeds that need a credential take it from the gitignored file at the repo
    # root. Dagger must receive it explicitly because module code is sandboxed.
    GTFS_SECRETS_FILE="${APP_ROOT}/gtfs-secrets.json"
    if [ -f "$GTFS_SECRETS_FILE" ]; then
        USE_TRANSIT_FLAGS="${USE_TRANSIT_FLAGS} --gtfs-secrets file://${GTFS_SECRETS_FILE}"
    fi
fi

USE_TRANSIT_ONLY_CMD=""
if [ "$TRANSIT_ONLY" -eq 1 ]; then
    USE_TRANSIT_ONLY_CMD="| transit-only"
fi
status "Building artifacts into data/${HEADWAY_AREA}"
traced dagger dagger -c "with-area ${HEADWAY_AREA} --countries=${HEADWAY_COUNTRIES} ${USE_LOCAL_PBF} ${USE_TRANSIT_FLAGS} ${USE_TRANSIT_ONLY_CMD} | build | export 'data/${HEADWAY_AREA}'"

status "Pinning artifacts"
bin/artifacts --pin "$CONFIG_DIR"
