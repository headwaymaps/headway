#!/usr/bin/env bash
# Serves the transit-zoner API. The UI lives in the frontend app at
# /transit-zones; point its dev server at this with a proxy, or run the whole
# stack with docker compose.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

asset_dir="$repo_root/data/transit-zoner"
atlas_dir="$asset_dir/atlas"
index_path="$asset_dir/feed-extents.gpkg"

if [[ ! -d "$atlas_dir" || ! -f "$index_path" ]]; then
    bin/build-gtfs-index --atlas-path "$atlas_dir" --out "$index_path"
fi

cargo run --release --package transit-zoner -- \
    --gtfs-index "$index_path" \
    "$@"
