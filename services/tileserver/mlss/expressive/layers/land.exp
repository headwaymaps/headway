// Headway v3 land layers. Draw order is owned by style.exp.

sources = import "../sources.exp"

[
{
  ...sources.landuse,
  "id": "landuse_residential",
  "type": "fill",
  "maxzoom": 17,
  "filter": [
  "==",
  "class",
  "residential"
],
  "paint": {
  "fill-opacity": {
    "stops": [
      [
        16,
        1
      ],
      [
        17,
        0
      ]
    ]
  },
  "fill-color": {
    "stops": [
      [
        9,
        "hsla(0, 3%, 85%, 0.84)"
      ],
      [
        12,
        "hsla(35, 57%, 88%, 0.49)"
      ]
    ]
  }
}
},
{
  ...sources.omt_landcover,
  "id": "landcover_wood",
  "type": "fill",
  "filter": [
  "==",
  "class",
  "wood"
],
  "paint": {
  "fill-antialias": false,
  "fill-color": "hsl(101,62.6%,43.3%)",
  "fill-opacity": 0.3
}
},
{
  ...sources.omt_landcover,
  "id": "landcover_grass",
  "type": "fill",
  "filter": [
  "==",
  "class",
  "grass"
],
  "paint": {
  "fill-antialias": false,
  "fill-color": "hsl(101,62.6%,63.3%)",
  "fill-opacity": 0.5
}
},
{
  ...sources.omt_landcover,
  "id": "landcover_ice",
  "type": "fill",
  "filter": [
  "==",
  "class",
  "ice"
],
  "paint": {
  "fill-antialias": false,
  "fill-color": "rgba(224, 236, 236, 1)",
  "fill-opacity": 0.8
}
},
{
  ...sources.landuse,
  "id": "landuse_cemetery",
  "type": "fill",
  "filter": [
  "==",
  "class",
  "cemetery"
],
  "paint": {
  "fill-color": "hsl(75, 37%, 81%)"
}
},
{
  ...sources.landuse,
  "id": "landuse_hospital",
  "type": "fill",
  "filter": [
  "==",
  "class",
  "hospital"
],
  "paint": {
  "fill-color": "#fde"
}
},
{
  ...sources.landuse,
  "id": "landuse_school",
  "type": "fill",
  "filter": [
  "==",
  "class",
  "school"
],
  "paint": {
  "fill-color": "rgb(236,238,204)"
}
},
{
  ...sources.waterway,
  "id": "waterway_tunnel",
  "type": "line",
  "filter": [
  "==",
  "brunnel",
  "tunnel"
],
  "paint": {
  "line-color": "rgb(141,220,248)",
  "line-dasharray": [
    3,
    3
  ],
  "line-gap-width": {
    "stops": [
      [
        12,
        0
      ],
      [
        20,
        6
      ]
    ]
  },
  "line-width": {
    "base": 1.4,
    "stops": [
      [
        8,
        1
      ],
      [
        20,
        2
      ]
    ]
  }
}
},
{
  ...sources.omt_landcover,
  "id": "landcover_sand",
  "type": "fill",
  "filter": [
  "==",
  "class",
  "sand"
],
  "paint": {
  "fill-color": "rgba(247, 239, 195, 1)"
}
},
{
  ...sources.water,
  "id": "water",
  "type": "fill",
  "filter": [
  "!=",
  "brunnel",
  "tunnel"
],
  "paint": {
  "fill-color": "rgb(141,220,248)"
}
},
{
  ...sources.waterway,
  "id": "waterway_river",
  "type": "line",
  "filter": [
  "all",
  [
    "==",
    "class",
    "river"
  ],
  [
    "!=",
    "brunnel",
    "tunnel"
  ]
],
  "layout": {
  "line-cap": "round"
},
  "paint": {
  "line-color": "rgb(141,220,248)",
  "line-width": {
    "base": 1.2,
    "stops": [
      [
        11,
        0.5
      ],
      [
        20,
        6
      ]
    ]
  }
}
},
{
  ...sources.waterway,
  "id": "waterway_other",
  "type": "line",
  "filter": [
  "all",
  [
    "!=",
    "class",
    "river"
  ],
  [
    "!=",
    "brunnel",
    "tunnel"
  ]
],
  "layout": {
  "line-cap": "round"
},
  "paint": {
  "line-color": "rgb(141,220,248)",
  "line-width": {
    "base": 1.3,
    "stops": [
      [
        13,
        0.5
      ],
      [
        20,
        6
      ]
    ]
  }
}
}
]
