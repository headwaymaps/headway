// Headway v3 base layers. Draw order is owned by style.exp.

sources = import "../sources.exp"

[
{
  "id": "background",
  "type": "background",
  "paint": {
  "background-color": "rgb(241,239,231)"
}
},
{
  ...sources.terrain,
  "id": "terrain",
  "type": "raster",
  "maxzoom": 8,
  "paint": {
  "raster-opacity": {
    "stops": [
      [
        5,
        0.8
      ],
      [
        6,
        0
      ]
    ]
  }
}
},
{
  ...sources.landcover_layer,
  "id": "landcover",
  "type": "fill",
  "maxzoom": 8,
  "paint": {
  "fill-opacity": {
    "stops": [
      [
        7,
        0.4
      ],
      [
        8,
        0
      ]
    ]
  },
  "fill-color": [
    "match",
    [
      "get",
      "class"
    ],
    "barren",
    "rgb(255, 231, 220)",
    "crop",
    "rgb(149, 222, 58)",
    "grass",
    "rgb(230, 255, 133)",
    "shrub",
    "rgb(230, 255, 133)",
    "snow",
    "rgb(250, 250, 250)",
    "trees",
    "rgb(130, 235, 60)",
    "urban",
    "rgb(226, 231, 215)",
    "transparent"
  ]
}
},
{
  ...sources.park,
  "id": "park",
  "type": "fill",
  "paint": {
  "fill-color": "hsl(101,62.6%,63.3%)",
  "fill-opacity": 0.7,
  "fill-outline-color": "rgba(95, 208, 100, 1)"
}
},
{
  ...sources.park,
  "id": "park_outline",
  "type": "line",
  "paint": {
  "line-dasharray": [
    1,
    1.5
  ],
  "line-color": "rgb(228, 241, 215)"
}
}
]
