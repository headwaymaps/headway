{
  ...sources.openmaptiles,
  "id": "poi_transit",
  "type": "symbol",
  "source-layer": "poi",
  "filter": [
  "in",
  "class",
  "bus",
  "rail",
  "airport"
],
  "layout": {
  "icon-image": "{class}_11",
  "text-anchor": "left",
  "text-field": "{name_en}",
  "text-font": [
    "Roboto Condensed Italic"
  ],
  "text-max-width": 9,
  "text-offset": [
    0.9,
    0
  ],
  "text-size": 12
},
  "paint": {
  "text-color": "#4898ff",
  "text-halo-blur": 0.5,
  "text-halo-color": "#ffffff",
  "text-halo-width": 1
}
},
{
  ...sources.openmaptiles,
  "id": "road_label",
  "type": "symbol",
  "source-layer": "transportation_name",
  "layout": {
  "symbol-placement": "line",
  "text-field": "{name}",
  "text-font": [
    "Roboto Regular"
  ],
  "text-offset": [
    0,
    0.15
  ],
  "text-size": {
    "stops": [
      [
        13,
        12
      ],
      [
        14,
        13
      ]
    ]
  }
},
  "paint": {
  "text-color": "#765",
  "text-halo-blur": 0.5,
  "text-halo-color": "#ffffff",
  "text-halo-width": 1
}
},
{
  ...sources.openmaptiles,
  "id": "road_shield",
  "type": "symbol",
  "source-layer": "transportation_name",
  "minzoom": 7,
  "filter": [
  "all",
  [
    "has",
    "network"
  ],
  [
    "has",
    "ref"
  ],
  [
    "<=",
    [
      "length",
      [
        "coalesce",
        [
          "get",
          "route_1_ref"
        ],
        [
          "get",
          "ref"
        ]
      ]
    ],
    6
  ]
],
  "layout": {
  "icon-image": [
    "let",
    "ref",
    [
      "coalesce",
      [
        "get",
        "route_1_ref"
      ],
      [
        "get",
        "ref"
      ]
    ],
    [
      "let",
      "shield_base",
      [
        "match",
        [
          "get",
          "route_1_network"
        ],
        "US:I",
        "us-interstate",
        "US:US",
        "us-highway",
        "US:CA",
        "us-state-ca",
        "US:OR",
