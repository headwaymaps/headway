#!/bin/bash -ex

HGT_DIR=$1
if [ -z "$HGT_DIR" ]; then
    echo "Missing param for input directory of .hgt files"
    exit 1
fi

TIF_DIR=$2
if [ -z "$TIF_DIR" ]; then
    echo "Missing param for output directory of .tif files"
    exit 1
fi

mkdir "$TIF_DIR"

# Read each tile straight out of its gzip, and write it compressed: with a predictor, elevation
# compresses about 4x, and travelmux and OTP both read it.
find "$HGT_DIR" -type f -name '*.hgt.gz' | while read -r file; do
    TIF_NAME="$(basename "$file" .hgt.gz).tif"
    gdal_translate -co COMPRESS=DEFLATE -co PREDICTOR=2 -co TILED=YES \
        "/vsigzip/${file}" "${TIF_DIR}/${TIF_NAME}"
done
