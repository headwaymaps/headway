# Locations the integration and browser tests assert against for this build. They're in Seattle
# because the planet only has transit and elevation in its transit zones, puget-sound among them.

# Pike Place Market
START_LAT=47.6097
START_LNG=-122.3422
# Space Needle
END_LAT=47.6205
END_LNG=-122.3493
# University of Washington - far enough from START that transit beats walking
TRANSIT_END_LAT=47.6498
TRANSIT_END_LNG=-122.3038
TRANSIT_TZ=America/Los_Angeles
# START -> END, as a polyline6 of (lat, lon)
ELEVATION_PATH=guzxyAnrdjhF_bTvzL
# z/x/y of a tile covering START
TILE=13/1312/2860
# Autocompleted near START, the first result should be named SEARCH_RESULT
SEARCH_TEXT="Pike Place"
SEARCH_RESULT="Pike Place Market"

# Browser tests search for these by name, so each must be the top result even without a focus
# point, and its display name must contain the query.
DESTINATION="Space Needle"
ORIGIN="Pike Place"
