# Locations the integration and browser tests assert against for this build.

# Plaza de Bolívar
START_LAT=4.5981
START_LNG=-74.0758
# A short walk from START
END_LAT=4.6029
END_LNG=-74.067
# Portal Norte - far enough from START that transit beats walking
TRANSIT_END_LAT=4.7085
TRANSIT_END_LNG=-74.0425
TRANSIT_TZ=America/Bogota
# START -> END, as a polyline6 of (lat, lon)
ELEVATION_PATH=gtswGnhfhlC_kH_eP
# z/x/y of a tile covering START
TILE=13/2409/3990
# Autocompleted near START, the first result should be named SEARCH_RESULT
SEARCH_TEXT=Plaza
SEARCH_RESULT="Plaza de Bolívar"

# Browser tests search for these by name, so each must be the top result even without a focus
# point, and its display name must contain the query - many Bogota POIs carry an English
# `name:en` that the app prefers, so e.g. "Museo del Oro" lands on a page titled "Gold Museum".
DESTINATION="Universidad Nacional"
ORIGIN=Monserrate
